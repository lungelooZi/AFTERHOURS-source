# Copy to apps/api/.env (never commit the real file).
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://afterhours:afterhours@localhost:5432/afterhours
SESSION_TTL_HOURS=168
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Set to true only behind a reverse proxy you control, so req.ip is the real client.
TRUST_PROXY=false
