# Copy to apps/api/.env (never commit the real file).
NODE_ENV=development
# postgres (default) or memory (no database; everything is lost on restart)
STORE=postgres
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://afterhours:afterhours@localhost:5432/afterhours
SESSION_TTL_HOURS=168
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Public address of the game, used in password reset links.
APP_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
# Which proxies may tell the API the client's IP (X-Forwarded-For).
# loopback = the AFTERHOURS web server on this machine (npm start). Never use true
# unless every request reaches the API through a proxy you control.
TRUST_PROXY=loopback
